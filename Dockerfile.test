FROM kalilinux/kali-rolling:latest

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install required tools
RUN apt-get update && apt-get install -y \
    bash \
    curl \
    smbclient \
    python3 \
    python3-pip \
    grep \
    gawk \
    sed \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

# Ensure Unix line endings even if files were checked out with CRLF on Windows
RUN sed -i 's/\r$//' /app/linux_audit.sh /app/tests/test_linux_audit.sh

# Make scripts executable
RUN chmod +x /app/linux_audit.sh /app/tests/test_linux_audit.sh

CMD ["/app/tests/test_linux_audit.sh"]
